PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Почта для восстановления пароля (необязательно). Если не задано —
# письмо не отправляется, а ссылка для сброса просто выводится в консоль
# сервера, что удобно для локальной разработки.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
