<%- include('../partials/head') -%>
<%- include('../partials/header') -%>

<div class="container">
  <div class="eyebrow">Каталог наград</div>
  <h1 style="font-size:32px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text);">Ачивки</h1>
  <p>Ачивки отображаются в профиле с редкостью: обычная, редкая, эпическая, легендарная. Ачивке можно задать несколько уровней — при достижении порога следующего уровня она автоматически повышается, а не выдаётся заново.</p>
  <%- include('../partials/admin_nav') -%>

  <div class="layout-2col">
    <div style="display:flex; flex-direction:column; gap:12px;">
      <% achievements.forEach(function(row){ %>
        <% var a = row.achievement; var first = a.levels[0]; %>
        <div class="achievement-card" style="align-items:flex-start;">
          <span class="icon">
            <% if (first.avatarFile) { %>
              <img src="/uploads/achievements/<%= first.avatarFile %>" alt="">
            <% } else { %>
              <%= first.icon %>
            <% } %>
          </span>
          <div style="flex:1;">
            <strong><%= a.name %></strong>
            <div class="text-faint" style="font-size:12px;"><%= a.description %></div>
            <div class="pill-group" style="margin-top:8px;">
              <% a.levels.forEach(function(lvl, i){ %>
                <span class="level-pill rarity-<%= lvl.rarity %>">
                  <%= lvl.icon %> <%= rarityLabels[lvl.rarity] %><% if (a.levels.length > 1) { %> · ур. <%= i + 1 %><% } %><% if (lvl.threshold) { %> (≥<%= lvl.threshold %>)<% } %>
                </span>
              <% }); %>
            </div>
            <div class="pill-group" style="margin-top:6px;">
              <span class="text-faint" style="font-size:11px;">Присвоена <%= row.awardedCount %> раз</span>
              <% if (a.autoRuleType && autoRuleTypes[a.autoRuleType]) { %>
                <span class="badge-auto">⚡ авто: <%= autoRuleTypes[a.autoRuleType].label.toLowerCase() %></span>
              <% } else { %>
                <span class="badge-auto" style="color:var(--text-faint); border-color:var(--border); background:transparent;">вручную</span>
              <% } %>
            </div>
          </div>
          <div class="btn-group" style="flex-direction:column;">
            <a href="/admin/achievements/<%= a.id %>/edit" class="btn btn-small">Изменить</a>
            <form action="/admin/achievements/<%= a.id %>?_method=DELETE" method="POST" data-confirm="Удалить ачивку «<%= a.name %>» из каталога? Она будет отозвана у всех, кому присвоена.">
              <button type="submit" class="btn btn-small btn-danger" style="width:100%;">Удалить</button>
            </form>
          </div>
        </div>
      <% }); %>
      <% if (!achievements.length) { %><p class="text-faint">Каталог пуст.</p><% } %>
    </div>

    <div class="panel">
      <div class="panel-title"><%= achievement ? 'Редактировать ачивку' : 'Добавить ачивку' %></div>
      <form action="<%= achievement ? '/admin/achievements/' + achievement.id + '?_method=PUT' : '/admin/achievements' %>" method="POST" enctype="multipart/form-data" class="stack">
        <div class="field">
          <label for="name">Название / подпись</label>
          <input type="text" id="name" name="name" value="<%= achievement ? achievement.name : '' %>" required>
        </div>
        <div class="field">
          <label for="description">Описание</label>
          <textarea id="description" name="description" rows="3"><%= achievement ? achievement.description : '' %></textarea>
        </div>

        <div class="field">
          <label for="autoRuleType">Условие автоприсвоения</label>
          <select id="autoRuleType" name="autoRuleType">
            <option value="">Только вручную</option>
            <% Object.keys(autoRuleTypes).forEach(function(key){ %>
              <option value="<%= key %>" <%= achievement && achievement.autoRuleType === key ? 'selected' : '' %>><%= autoRuleTypes[key].label %></option>
            <% }); %>
          </select>
          <p class="hint" style="margin-bottom:0;">Если выбрано условие — у каждого уровня нужно указать порог, по возрастанию. Задним числом пересчитывается для всех участников при сохранении.</p>
        </div>

        <div>
          <label style="display:block; margin-bottom:8px;">Уровни (редкость нарастает сверху вниз)</label>
          <div id="levels-container">
            <% var levels = achievement ? achievement.levels : [{ rarity: 'common', threshold: null, icon: '🏅', avatarFile: null }]; %>
            <% levels.forEach(function(lvl, i){ %>
              <div class="level-row">
                <button type="button" class="level-row-remove" title="Удалить уровень">✕</button>
                <div class="level-row-title">Уровень <%= i + 1 %></div>
                <div class="field-row">
                  <div class="field">
                    <label>Редкость</label>
                    <select name="level_<%= i %>_rarity" data-field="rarity">
                      <% rarityOrder.forEach(function(r){ %>
                        <option value="<%= r %>" <%= lvl.rarity === r ? 'selected' : '' %>><%= rarityLabels[r] %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="field">
                    <label>Порог (для авто)</label>
                    <input type="number" name="level_<%= i %>_threshold" data-field="threshold" min="1" placeholder="напр. 10" value="<%= lvl.threshold || '' %>">
                  </div>
                </div>
                <div class="field-row">
                  <div class="field">
                    <label>Иконка (эмодзи)</label>
                    <input type="text" name="level_<%= i %>_icon" data-field="icon" maxlength="4" value="<%= lvl.icon %>">
                  </div>
                  <div class="field">
                    <label>Аватарка уровня</label>
                    <input type="file" name="level_<%= i %>_avatar" data-field="avatar" accept=".png,.jpg,.jpeg,.webp,.gif,.svg">
                    <% if (lvl.avatarFile) { %>
                      <label class="hint" style="display:flex; align-items:center; gap:6px; margin-top:6px;">
                        <input type="checkbox" name="level_<%= i %>_removeAvatar" value="1" style="width:auto;"> убрать текущую (<img src="/uploads/achievements/<%= lvl.avatarFile %>" alt="" style="width:16px; height:16px; border-radius:4px; vertical-align:middle;">)
                      </label>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
          <button type="button" id="add-level-btn" class="btn btn-small" style="margin-top:10px;">+ Добавить уровень</button>
        </div>

        <template id="level-row-template">
          <div class="level-row">
            <button type="button" class="level-row-remove" title="Удалить уровень">✕</button>
            <div class="level-row-title">Уровень</div>
            <div class="field-row">
              <div class="field">
                <label>Редкость</label>
                <select data-field="rarity">
                  <% rarityOrder.forEach(function(r){ %>
                    <option value="<%= r %>"><%= rarityLabels[r] %></option>
                  <% }); %>
                </select>
              </div>
              <div class="field">
                <label>Порог (для авто)</label>
                <input type="number" data-field="threshold" min="1" placeholder="напр. 10">
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Иконка (эмодзи)</label>
                <input type="text" data-field="icon" maxlength="4" value="🏅">
              </div>
              <div class="field">
                <label>Аватарка уровня</label>
                <input type="file" data-field="avatar" accept=".png,.jpg,.jpeg,.webp,.gif,.svg">
              </div>
            </div>
          </div>
        </template>

        <button type="submit" class="btn btn-primary btn-block"><%= achievement ? 'Сохранить' : 'Добавить' %></button>
        <% if (achievement) { %><a href="/admin/achievements" class="btn btn-block" style="text-align:center;">Отмена</a><% } %>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') -%>
