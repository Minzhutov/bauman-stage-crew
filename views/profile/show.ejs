<%- include('../partials/head') -%>
<%- include('../partials/header') -%>

<div class="container">
  <div class="profile-hero">
    <div class="profile-avatar-wrap">
      <div class="profile-avatar" <% if (profile.user.avatarFile) { %>data-lightbox="/uploads/avatars/<%= profile.user.avatarFile %>"<% } %>>
        <% if (profile.user.avatarFile) { %>
          <img src="/uploads/avatars/<%= profile.user.avatarFile %>" alt="">
        <% } else { %>
          <%= profile.user.fullName.trim().charAt(0).toUpperCase() %>
        <% } %>
      </div>
      <% if (isOwner || isAdmin) { %>
        <div class="avatar-actions">
          <form action="/profile/<%= profile.user.id %>/avatar" method="POST" enctype="multipart/form-data">
            <label class="avatar-action-btn" for="avatarInput">Изменить фото</label>
            <input type="file" id="avatarInput" name="avatar" accept=".png,.jpg,.jpeg,.webp,.gif" data-autosubmit hidden>
          </form>
          <% if (profile.user.avatarFile) { %>
            <form action="/profile/<%= profile.user.id %>/avatar?_method=DELETE" method="POST" data-confirm="Удалить фото профиля?">
              <button type="submit" class="avatar-action-btn avatar-action-danger">Удалить</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
    <div>
      <h1 style="font-size:28px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text); margin-bottom:4px;"><%= profile.user.fullName %></h1>
      <div class="pill-group">
        <span class="<%= profile.user.role === 'admin' ? 'chip-role' : profile.user.role === 'tech_director' ? 'chip-tech' : profile.user.role === 'mentor' ? 'chip-mentor' : 'chip-user' %>"><%= auth.ROLE_LABELS[profile.user.role] %></span>
        <% if (profile.user.studyGroup) { %><span class="pill">🎓 <%= profile.user.studyGroup %></span><% } %>
        <span class="pill mono" style="color:var(--amber);"><%= profile.points %> баллов</span>
        <span class="pill">В команде с <%= h.formatDate(profile.user.createdAt) %></span>
      </div>
    </div>
  </div>

  <div class="stat-strip stat-strip-profile">
    <div class="stat-tile"><div class="value mono" style="color:var(--amber);"><%= profile.points %></div><div class="label">Баллов</div></div>
    <div class="stat-tile"><div class="value"><%= profile.stats.eventsCompleted %></div><div class="label">Мероприятий отработано</div></div>
    <div class="stat-tile"><div class="value"><%= profile.stats.academiesAttended %></div><div class="label">Лекций Академии</div></div>
    <div class="stat-tile"><div class="value"><%= profile.achievements.length %></div><div class="label">Ачивок получено</div></div>
    <div class="stat-tile"><div class="value"><%= profile.positions.length %></div><div class="label">Должностей доступно</div></div>
  </div>

  <% if (profile.topAchievements.length) { %>
    <div class="achievement-board">
      <div class="achievement-board-title">🏆 Доска достижений</div>
      <div class="achievement-board-grid">
        <% profile.topAchievements.forEach(function(ua){ %>
          <% var lvl = ua.levelData; var tiered = ua.achievement.levels.length > 1; %>
          <div class="medal" title="<%= ua.achievement.description || '' %>">
            <span class="medal-badge medal-badge-board rarity-<%= lvl.rarity %>">
              <% if (lvl.avatarFile) { %>
                <img src="/uploads/achievements/<%= lvl.avatarFile %>" alt="">
              <% } else { %>
                <%= lvl.icon %>
              <% } %>
              <% if (!ua.awardedBy) { %><span class="medal-auto-mark" title="Начислено автоматически">⚡</span><% } %>
              <% if (tiered) { %><span class="medal-level-mark"><%= ua.levelIndex + 1 %></span><% } %>
            </span>
            <span class="medal-name"><%= ua.achievement.name %></span>
            <span class="medal-rarity rarity-<%= lvl.rarity %>"><%= domain.RARITY_LABELS[lvl.rarity] %></span>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <div class="layout-2col" style="margin-top:28px;">
    <div>
      <!-- Контакты -->
      <div class="panel">
        <div class="panel-title">Контактная информация</div>
        <% if (isOwner || isAdmin) { %>
          <form action="/profile/<%= profile.user.id %>?_method=PUT" method="POST" class="stack">
            <div class="field-row">
              <div class="field">
                <label for="fullName">Имя и фамилия</label>
                <input type="text" id="fullName" name="fullName" value="<%= profile.user.fullName %>" required>
              </div>
              <div class="field">
                <label for="studyGroup">Учебная группа</label>
                <input type="text" id="studyGroup" name="studyGroup" value="<%= profile.user.studyGroup || '' %>" placeholder="ИУ7-11" required>
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label for="phone">Телефон</label>
                <input type="tel" id="phone" name="phone" value="<%= profile.user.phone || '' %>">
              </div>
              <div class="field">
                <label for="telegram">Telegram</label>
                <input type="text" id="telegram" name="telegram" value="<%= profile.user.telegram || '' %>" placeholder="@username">
              </div>
            </div>
            <div class="field">
              <label>Email</label>
              <input type="text" value="<%= profile.user.email %>" disabled style="opacity:.6;">
            </div>
            <div class="field">
              <label for="bio">О себе</label>
              <textarea id="bio" name="bio" rows="3"><%= profile.user.bio || '' %></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Сохранить</button>
          </form>
        <% } else { %>
          <p><strong>Email:</strong> <%= profile.user.email %></p>
          <p><strong>Учебная группа:</strong> <%= profile.user.studyGroup || '—' %></p>
          <!-- Телефон в чужом профиле виден только администратору (см. форму выше) -->
          <p><strong>Telegram:</strong> <% if (profile.user.telegram) { %><a href="https://t.me/<%= profile.user.telegram %>" target="_blank" rel="noopener" style="color:var(--violet-bright);">@<%= profile.user.telegram %></a><% } else { %>—<% } %></p>
          <% if (profile.user.bio) { %><p><%= profile.user.bio %></p><% } %>
        <% } %>
      </div>

      <!-- Мероприятия -->
      <div class="panel">
        <div class="panel-title">
          <span>Мероприятия</span>
          <a href="/profile/<%= profile.user.id %>/events.pdf" class="btn btn-small" style="text-transform:none; letter-spacing:0; font-weight:600;">⇩ Выгрузить список мероприятий</a>
        </div>
        <% if (!profile.signups.length) { %>
          <p class="text-faint">Пока нет заявок на мероприятия.</p>
        <% } else { %>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <% profile.signups.forEach(function(s){ %>
              <a href="/events/<%= s.event.id %>" class="card card-link" style="display:flex; justify-content:space-between; align-items:center; padding:14px 16px;">
                <span>
                  <strong style="color:var(--text);"><%= s.event.title %></strong>
                  <div class="text-faint" style="font-size:12px;"><%= s.position ? s.position.name : '—' %> · <%= h.formatDateTime(s.event.startsAt) %></div>
                </span>
                <span class="badge badge-<%= s.status %>"><%= s.status === 'pending' ? 'ожидает' : s.status === 'approved' ? 'подтверждён' : s.status === 'done' ? 'выполнено (+' + s.pointsAwarded + ')' : 'отклонён' %></span>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- Академии -->
      <div class="panel">
        <div class="panel-title">Академии</div>
        <% if (!profile.academies.length) { %>
          <p class="text-faint">Пока нет записей на лекции.</p>
        <% } else { %>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <% profile.academies.forEach(function(a){ %>
              <a href="/academies/<%= a.academy.id %>" class="card card-link" style="display:flex; justify-content:space-between; align-items:center; padding:14px 16px;">
                <span>
                  <strong style="color:var(--text);"><%= a.academy.title %></strong>
                  <div class="text-faint" style="font-size:12px;"><%= a.academy.room %> · <%= h.formatDateTime(a.academy.startsAt) %></div>
                </span>
                <span class="badge <%= a.pointsAwarded !== null ? 'badge-done' : 'badge-planned' %>">
                  <%= a.pointsAwarded !== null ? 'пройдено (+' + a.pointsAwarded + ')' : 'записан' %>
                </span>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- История баллов -->
      <div class="panel">
        <div class="panel-title">История баллов</div>
        <% if (!profile.pointsHistory.length) { %>
          <p class="text-faint">Баллы ещё не начислялись.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Дата</th><th>Причина</th><th>Кто начислил</th><th>Баллы</th></tr></thead>
              <tbody>
                <% profile.pointsHistory.forEach(function(p){ %>
                  <tr>
                    <td class="text-faint"><%= h.formatDate(p.awardedAt) %></td>
                    <td>
                      <% if (p.event) { %>
                        <a href="/events/<%= p.event.id %>" style="color:var(--text);"><%= p.reason %></a>
                      <% } else if (p.academy) { %>
                        <a href="/academies/<%= p.academy.id %>" style="color:var(--text);"><%= p.reason %></a>
                      <% } else if (p.manual) { %>
                        <a href="/manuals/<%= p.manual.id %>" style="color:var(--text);"><%= p.reason %></a>
                      <% } else { %>
                        <%= p.reason %>
                      <% } %>
                    </td>
                    <td class="text-faint"><%= p.awardedByUser ? p.awardedByUser.fullName : '—' %></td>
                    <td class="points-cell"><%= p.amount > 0 ? '+' : '' %><%= p.amount %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>

        <% if (isStaff) { %>
          <form action="/profile/<%= profile.user.id %>/points" method="POST" class="field-row" style="margin-top:16px; align-items:flex-end;">
            <div class="field">
              <label for="amount">Баллы (+/-)</label>
              <input type="number" id="amount" name="amount" required>
            </div>
            <div class="field" style="grid-column: span 1;">
              <label for="reason">Причина</label>
              <input type="text" id="reason" name="reason" required>
            </div>
            <button type="submit" class="btn btn-primary" style="height:44px;">Начислить</button>
          </form>
        <% } %>
      </div>
    </div>

    <div>
      <!-- Должности -->
      <div class="panel">
        <div class="panel-title">Доступные должности</div>
        <% if (isAdmin) { %>
          <% if (profile.positions.length) { %>
            <div class="pill-group" style="margin-bottom:16px;">
              <% profile.positions.forEach(function(p){ %><span class="pill"><%= p.name %></span><% }); %>
            </div>
          <% } else { %>
            <p class="text-faint" style="margin-bottom:16px;">Должности не назначены.</p>
          <% } %>
        <% } else { %>
          <% domain.groupPositionsByCategory(allPositions).forEach(function(group){ %>
            <div class="position-category-group">
              <div class="position-category-label"><%= group.label %></div>
              <div class="position-catalog">
                <% group.positions.forEach(function(p){ %>
                  <% var granted = profile.positions.some(function(up){ return up.id === p.id; }); %>
                  <div class="position-catalog-item <%= granted ? 'is-granted' : '' %>" title="<%= p.description || '' %>">
                    <span class="position-catalog-mark"><%= granted ? '✓' : '' %></span>
                    <span><%= p.name %></span>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
          <% if (!allPositions.length) { %><p class="text-faint">Каталог должностей пуст.</p><% } %>
        <% } %>

        <% if (isAdmin) { %>
          <form action="/profile/<%= profile.user.id %>/positions" method="POST" class="stack">
            <div style="display:flex; flex-direction:column; gap:14px; max-height:320px; overflow-y:auto;">
              <% domain.groupPositionsByCategory(allPositions).forEach(function(group){ %>
                <div>
                  <div class="position-category-label"><%= group.label %></div>
                  <div style="display:flex; flex-direction:column; gap:8px;">
                    <% group.positions.forEach(function(p){ %>
                      <label class="check-row" style="text-transform:none; font-weight:400; color:var(--text);">
                        <input type="checkbox" name="positionIds" value="<%= p.id %>" <%= profile.positions.some(function(up){ return up.id === p.id; }) ? 'checked' : '' %>>
                        <%= p.name %>
                      </label>
                    <% }); %>
                  </div>
                </div>
              <% }); %>
              <% if (!allPositions.length) { %><p class="text-faint">Каталог должностей пуст.</p><% } %>
            </div>
            <button type="submit" class="btn btn-small">Обновить должности</button>
          </form>
        <% } %>
      </div>

      <!-- Ачивки (медали) -->
      <div class="panel">
        <div class="panel-title" style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
          <span>Ачивки</span>
          <a href="/achievements" class="btn btn-small" style="text-transform:none; letter-spacing:0; font-weight:600;">Посмотреть все ачивки</a>
        </div>
        <% if (!profile.achievements.length) { %>
          <p class="text-faint" style="margin-bottom: <%= isAdmin ? '16px' : '0' %>;">Ачивок пока нет.</p>
        <% } else { %>
          <% var collapseLimit = 4; %>
          <div class="medal-grid" id="achievements-grid" style="margin-bottom:12px;">
            <% profile.achievements.forEach(function(ua, i){ %>
              <% var lvl = ua.levelData; var tiered = ua.achievement.levels.length > 1; %>
              <div class="medal <%= i >= collapseLimit ? 'medal-collapsed' : '' %>" title="<%= ua.achievement.description || '' %>">
                <span class="medal-badge rarity-<%= lvl.rarity %>">
                  <% if (lvl.avatarFile) { %>
                    <img src="/uploads/achievements/<%= lvl.avatarFile %>" alt="">
                  <% } else { %>
                    <%= lvl.icon %>
                  <% } %>
                  <% if (!ua.awardedBy) { %><span class="medal-auto-mark" title="Начислено автоматически">⚡</span><% } %>
                  <% if (tiered) { %><span class="medal-level-mark"><%= ua.levelIndex + 1 %></span><% } %>
                </span>
                <span class="medal-name"><%= ua.achievement.name %></span>
                <span class="medal-rarity rarity-<%= lvl.rarity %>"><%= domain.RARITY_LABELS[lvl.rarity] %></span>
                <span class="medal-date"><%= h.formatDate(ua.awardedAt) %></span>
                <% if (ua.comment) { %><span class="medal-comment">«<%= ua.comment %>»</span><% } %>
                <% if (isAdmin) { %>
                  <form action="/profile/<%= profile.user.id %>/achievements/<%= ua.id %>?_method=DELETE" method="POST" data-confirm="Отозвать ачивку «<%= ua.achievement.name %>»?">
                    <button type="submit" class="medal-revoke">отозвать</button>
                  </form>
                <% } %>
              </div>
            <% }); %>
          </div>
          <% if (profile.achievements.length > collapseLimit) { %>
            <button type="button" class="btn btn-small" data-show-all-target="#achievements-grid" style="margin-bottom: <%= isAdmin ? '18px' : '0' %>;">Показать все (<%= profile.achievements.length %>)</button>
          <% } %>
        <% } %>

        <% if (profile.achievementProgress.length) { %>
          <div style="margin-bottom: <%= isAdmin ? '18px' : '0' %>;">
            <% profile.achievementProgress.slice(0, 4).forEach(function(p){ %>
              <div class="progress-item">
                <div class="progress-item-head">
                  <span><span class="icon"><%= p.nextLevel.icon %></span> <%= p.achievement.name %></span>
                  <span class="medal-rarity rarity-<%= p.nextLevel.rarity %>">до «<%= domain.RARITY_LABELS[p.nextLevel.rarity] %>»: <%= p.metric %>/<%= p.nextLevel.threshold %></span>
                </div>
                <div class="progress"><div class="progress-fill rarity-<%= p.nextLevel.rarity %>" style="width:<%= p.percent %>%;"></div></div>
              </div>
            <% }); %>
          </div>
        <% } %>

        <% if (isAdmin) { %>
          <script type="application/json" id="achievements-data"><%- JSON.stringify(allAchievements.map(function(a){
            return { id: a.id, levels: a.levels.map(function(l, i){ return { index: i, rarity: l.rarity, label: domain.RARITY_LABELS[l.rarity] + (a.levels.length > 1 ? ' (ур. ' + (i+1) + ')' : '') }; }) };
          })) %></script>
          <form action="/profile/<%= profile.user.id %>/achievements" method="POST" class="stack">
            <div class="field-row">
              <div class="field">
                <label for="achievementId">Ачивка</label>
                <select id="achievementId" name="achievementId" required>
                  <% allAchievements.forEach(function(a){ %>
                    <option value="<%= a.id %>"><%= a.levels[0].icon %> <%= a.name %><%= a.autoRuleType ? ' (авто)' : '' %></option>
                  <% }); %>
                </select>
              </div>
              <div class="field">
                <label for="level">Уровень</label>
                <select id="level" name="level"></select>
              </div>
            </div>
            <div class="field">
              <label for="comment">Комментарий</label>
              <input type="text" id="comment" name="comment" placeholder="Необязательно">
            </div>
            <button type="submit" class="btn btn-small">Присвоить ачивку</button>
          </form>
        <% } %>
      </div>

      <!-- Бейджи мероприятий -->
      <div class="panel">
        <div class="panel-title">Бейджи мероприятий</div>
        <% if (!profile.badges.length) { %>
          <p class="text-faint" style="margin-bottom: <%= isOwner || isAdmin ? '16px' : '0' %>;">Бейджей пока нет.</p>
        <% } else { %>
          <div class="badge-gallery" style="margin-bottom: <%= isOwner || isAdmin ? '16px' : '0' %>;">
            <% profile.badges.forEach(function(b){ %>
              <div class="badge-card">
                <a href="/uploads/badges/<%= b.fileName %>" target="_blank" rel="noopener">
                  <img src="/uploads/badges/<%= b.fileName %>" alt="<%= b.title || 'Бейдж' %>">
                </a>
                <% if (b.title) { %><span class="badge-card-caption"><%= b.title %></span><% } %>
                <% if (isOwner || isAdmin) { %>
                  <form action="/profile/<%= profile.user.id %>/badges/<%= b.id %>?_method=DELETE" method="POST" data-confirm="Удалить бейдж?" class="badge-card-remove-form">
                    <button type="submit" class="badge-card-remove" title="Удалить">✕</button>
                  </form>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } %>
        <% if (isOwner || isAdmin) { %>
          <form action="/profile/<%= profile.user.id %>/badges" method="POST" enctype="multipart/form-data" class="field-row" style="align-items:flex-end;">
            <div class="field">
              <label for="badgeTitle">Подпись (необязательно)</label>
              <input type="text" id="badgeTitle" name="title" placeholder="Мисс Очарование 2025">
            </div>
            <div class="field">
              <label for="badgeInput">Фото бейджа или вырезка из PDF</label>
              <input type="file" id="badgeInput" name="badge" accept=".png,.jpg,.jpeg,.webp,.gif" required>
            </div>
            <button type="submit" class="btn btn-small" style="height:44px;">Добавить бейдж</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') -%>
