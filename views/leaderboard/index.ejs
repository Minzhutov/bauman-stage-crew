<%- include('../partials/head') -%>
<%- include('../partials/header') -%>

<div class="container">
  <div class="eyebrow">Рейтинг команды</div>
  <h1 style="font-size:32px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text);">Таблица лидеров</h1>
  <p>
    <% if (selectedSeason) { %>
      Зачёт за сезон «<%= selectedSeason.name %>»: <%= h.formatDate(selectedSeason.startsAt) %> — <%= h.formatDate(selectedSeason.endsAt) %>
    <% } else { %>
      Сводный рейтинг по баллам, начисленным администраторами за мероприятия и активность — за всё время.
    <% } %>
  </p>

  <% if (seasons.length) { %>
    <div class="season-tabs">
      <a href="/leaderboard?season=all" class="<%= !selectedSeason ? 'active' : '' %>">Всё время</a>
      <% seasons.forEach(function(s){ %>
        <a href="/leaderboard?season=<%= s.id %>" class="<%= selectedSeason && selectedSeason.id === s.id ? 'active' : '' %>"><%= s.name %></a>
      <% }); %>
    </div>
  <% } %>

  <% if (rows.length >= 3) { %>
    <div class="podium">
      <% [1,0,2].forEach(function(i){ var row = rows[i]; var cls = i===0 ? 'podium-gold' : i===1 ? 'podium-silver' : 'podium-bronze'; var medal = i===0 ? '🥇' : i===1 ? '🥈' : '🥉'; %>
        <div class="podium-card <%= cls %>">
          <div class="podium-rank"><%= i + 1 %></div>
          <div class="podium-avatar">
            <% if (row.user.avatarFile) { %>
              <img src="/uploads/avatars/<%= row.user.avatarFile %>" alt="">
            <% } else { %>
              <%= row.user.fullName.trim().charAt(0).toUpperCase() %>
            <% } %>
          </div>
          <div style="font-size:20px; margin-bottom:4px;"><%= medal %></div>
          <h3 style="margin:0 0 2px;"><%= row.user.fullName %></h3>
          <div class="text-faint" style="font-size:12px; margin-bottom:10px;"><%= auth.ROLE_LABELS[row.user.role] %></div>
          <div class="mono" style="font-size:22px; color:var(--amber); font-weight:700;"><%= row.points %> б.</div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Участник</th>
          <th>Роль</th>
          <th>Ачивки</th>
          <th>Смен закрыто</th>
          <th>Баллы</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(row, i){ %>
          <tr class="<%= i===0 ? 'rank-1' : i===1 ? 'rank-2' : i===2 ? 'rank-3' : '' %>">
            <td class="rank-cell"><%= i + 1 %></td>
            <td>
              <a href="/profile/<%= row.user.id %>" class="leader-name" style="color:var(--text); font-weight:600;">
                <span class="leader-avatar">
                  <% if (row.user.avatarFile) { %>
                    <img src="/uploads/avatars/<%= row.user.avatarFile %>" alt="">
                  <% } else { %>
                    <%= row.user.fullName.trim().charAt(0).toUpperCase() %>
                  <% } %>
                </span>
                <%= row.user.fullName %>
              </a>
            </td>
            <td><span class="<%= row.user.role === 'admin' ? 'chip-role' : row.user.role === 'tech_director' ? 'chip-tech' : 'chip-user' %>"><%= row.user.role === 'admin' ? 'Админ' : row.user.role === 'tech_director' ? 'Тех. директор' : 'Участник' %></span></td>
            <td><%= row.achievementsCount %></td>
            <td><%= row.completedEvents %></td>
            <td class="points-cell"><%= row.points %></td>
          </tr>
        <% }); %>
        <% if (!rows.length) { %>
          <tr><td colspan="6" class="text-faint" style="text-align:center; padding:30px;">Пока нет участников.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (adminRows.length) { %>
    <div class="eyebrow" style="margin-top:40px;">Вне общего зачёта</div>
    <h2 style="font-size:20px;">Администраторы</h2>
    <p class="text-faint" style="margin-bottom:16px;">Администраторы не участвуют в общем рейтинге, чтобы не соревноваться с командой за баллы. Таблица — для справки.</p>
    <div class="table-wrap" style="opacity:0.85;">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Участник</th>
            <th>Ачивки</th>
            <th>Смен закрыто</th>
            <th>Баллы</th>
          </tr>
        </thead>
        <tbody>
          <% adminRows.forEach(function(row, i){ %>
            <tr class="<%= i===0 ? 'rank-1' : i===1 ? 'rank-2' : i===2 ? 'rank-3' : '' %>">
              <td class="rank-cell"><%= i + 1 %></td>
              <td>
                <a href="/profile/<%= row.user.id %>" class="leader-name" style="color:var(--text); font-weight:600;">
                  <span class="leader-avatar">
                    <% if (row.user.avatarFile) { %>
                      <img src="/uploads/avatars/<%= row.user.avatarFile %>" alt="">
                    <% } else { %>
                      <%= row.user.fullName.trim().charAt(0).toUpperCase() %>
                    <% } %>
                  </span>
                  <%= row.user.fullName %>
                </a>
              </td>
              <td><%= row.achievementsCount %></td>
              <td><%= row.completedEvents %></td>
              <td class="points-cell"><%= row.points %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') -%>
