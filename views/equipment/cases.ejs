<%- include('../partials/head') -%>
<%- include('../partials/header') -%>

<div class="container">
  <div class="section-head">
    <div>
      <div class="eyebrow">Физические контейнеры с оборудованием</div>
      <h1 style="font-size:32px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text);">Кейсы</h1>
      <p>Кейс — рэк, «гроб» на колёсах, сумка и т.п.: пустой физический контейнер. Чем он заполнен под конкретное мероприятие — указывается отдельно на странице «Комплекты», и может отличаться от мероприятия к мероприятию. «Собран для» ниже появляется только после отметки «Собрано» на странице мероприятия — просто план на будущее кейс не занимает.</p>
    </div>
    <% if (auth.isStaff(currentUser)) { %><a href="/equipment/cases/new" class="btn btn-primary">+ Новый кейс</a><% } %>
  </div>
  <%- include('../partials/equipment_nav') -%>

  <% if (!cases.length) { %>
    <div class="empty"><div class="glyph">🧰</div>Кейсов пока нет.</div>
  <% } else { %>
    <div class="card-grid">
      <% cases.forEach(function(c){ %>
        <div class="card equip-card">
          <div class="equip-card-photo">
            <% if (c.photoFile) { %><img src="/uploads/cases/<%= c.photoFile %>" alt=""><% } else { %>🧰<% } %>
            <span class="badge badge-equip-<%= c.status %> equip-card-status"><%= domain.EQUIPMENT_STATUS_LABELS[c.status] %></span>
          </div>
          <div class="equip-card-body">
            <div>
              <h3 class="equip-card-title"><%= c.name %></h3>
              <span class="badge badge-planned" style="margin-top:6px;"><%= domain.CASE_TYPE_LABELS[c.type] %></span>
            </div>
            <% if (c.description) { %><p style="font-size:13px; margin:0;"><%= c.description %></p><% } %>
            <div class="meta">
              <% if (c.location) { %><span>📍 <%= c.location %></span><% } %>
              <% if (c.capacity != null) { %><span>Вместимость: <%= c.capacity %> <%= c.type === 'rack' ? 'U' : 'л' %></span><% } %>
              <span>Тара: <%= c.weight != null ? c.weight + ' кг' : '—' %></span>
              <% if (c.currentEvent) { %>
                <span>Собран для: <a href="/equipment/plans/<%= c.currentEvent.id %>"><%= c.currentEvent.title %></a></span>
                <% c.currentContents.items.forEach(function(row){ %>
                  <span>· <%= row.quantity %> × <%= row.item.name %></span>
                <% }); %>
                <span>
                  Загружено: <%= c.currentContents.capacityUsed %><% if (c.capacity != null) { %> из <%= c.capacity %><% } %> <%= c.currentContents.capacityUnit %>
                  <% if (c.currentContents.overCapacity) { %> <span style="color:var(--red);">— превышает вместимость!</span><% } %>
                </span>
              <% } else if (c.allocations.length) { %>
                <span class="text-faint">Запланирован, но пока не собран — физически свободен.</span>
              <% } else { %>
                <span class="text-faint">Свободен — состав указывается при сборке комплекта под мероприятие.</span>
              <% } %>
            </div>
            <% if (c.allocations.length) { %>
              <div style="font-size:11.5px; color:var(--text-faint); display:flex; flex-direction:column; gap:3px;">
                <% c.allocations.forEach(function(e){ %>
                  <div>Запланирован: <a href="/events/<%= e.id %>"><%= e.title %></a> — <%= h.formatDate(e.startsAt) %>–<%= h.formatDate(e.endsAt) %></div>
                <% }); %>
              </div>
            <% } %>
            <% if (auth.isStaff(currentUser)) { %>
              <form action="/equipment/cases/<%= c.id %>/status?_method=PUT" method="POST" style="display:flex; gap:6px; align-items:center;">
                <select name="status" data-quick-status style="flex:1; font-size:12px; padding:4px 6px;">
                  <% domain.EQUIPMENT_STATUS_ORDER.forEach(function(key){ %>
                    <option value="<%= key %>" <%= c.status === key ? 'selected' : '' %>><%= domain.EQUIPMENT_STATUS_LABELS[key] %></option>
                  <% }); %>
                </select>
                <noscript><button type="submit" class="btn btn-small">OK</button></noscript>
              </form>
              <div class="card-foot">
                <a href="/equipment/cases/<%= c.id %>/edit" class="btn btn-small">Редактировать</a>
                <form action="/equipment/cases/<%= c.id %>?_method=DELETE" method="POST" data-confirm="Удалить кейс «<%= c.name %>» из каталога?">
                  <button type="submit" class="btn btn-small btn-danger" <%= c.allocations.length ? 'disabled title="Занят мероприятием"' : '' %>>Удалить</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') -%>
