<%- include('../partials/head') -%>
<%- include('../partials/header') -%>

<div class="container" style="max-width:760px;">
  <div class="eyebrow">Оборудование</div>
  <h1 style="font-size:28px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text);"><%= title %></h1>

  <% if (item) { %>
    <div class="panel" style="margin-bottom:18px;">
      <div class="panel-title">Фото</div>
      <div style="display:flex; align-items:center; gap:18px; flex-wrap:wrap;">
        <span class="equip-thumb" style="width:72px; height:72px; font-size:28px;">
          <% if (item.photoFile) { %><img src="/uploads/cases/<%= item.photoFile %>" alt=""><% } else { %>🧰<% } %>
        </span>
        <div style="display:flex; flex-direction:column; gap:8px;">
          <form action="/equipment/cases/<%= item.id %>/photo" method="POST" enctype="multipart/form-data" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <input type="file" name="photo" accept="image/*" required>
            <button type="submit" class="btn btn-small">Загрузить</button>
          </form>
          <% if (item.photoFile) { %>
            <form action="/equipment/cases/<%= item.id %>/photo?_method=DELETE" method="POST" data-confirm="Удалить фото?">
              <button type="submit" class="btn btn-small btn-danger">Удалить фото</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <% if (stock && stock.allocations.length) { %>
      <div class="panel" style="margin-bottom:18px;">
        <div class="panel-title">Уже забронирован</div>
        <div style="display:flex; flex-direction:column; gap:4px; font-size:13px;">
          <% stock.allocations.forEach(function(e){ %>
            <div><a href="/events/<%= e.id %>"><%= e.title %></a> — <%= h.formatDate(e.startsAt) %>–<%= h.formatDate(e.endsAt) %></div>
          <% }); %>
        </div>
      </div>
    <% } %>
  <% } %>

  <form action="<%= item ? '/equipment/cases/' + item.id + '?_method=PUT' : '/equipment/cases' %>" method="POST" <%= item ? '' : 'enctype="multipart/form-data"' %> class="stack panel">
    <div class="field">
      <label for="name">Название кейса</label>
      <input type="text" id="name" name="name" value="<%= form.name || '' %>" required placeholder="Напр. Световой рэк №1">
    </div>
    <div class="field-row">
      <div class="field">
        <label for="type">Тип</label>
        <select id="type" name="type">
          <% typeOrder.forEach(function(key){ %>
            <option value="<%= key %>" <%= (form.type || 'rack') === key ? 'selected' : '' %>><%= typeLabels[key] %></option>
          <% }); %>
        </select>
      </div>
      <% if (item) { %>
        <div class="field">
          <label for="status">Статус</label>
          <select id="status" name="status">
            <% statusOrder.forEach(function(key){ %>
              <option value="<%= key %>" <%= form.status === key ? 'selected' : '' %>><%= statusLabels[key] %></option>
            <% }); %>
          </select>
        </div>
      <% } %>
    </div>
    <div class="field">
      <label for="location">Местоположение</label>
      <input type="text" id="location" name="location" value="<%= form.location || '' %>" placeholder="Напр. Склад Б, стеллаж 2">
    </div>
    <div class="field-row">
      <div class="field">
        <label for="capacity">Вместимость</label>
        <input type="number" id="capacity" name="capacity" min="0" step="0.1" value="<%= form.capacity != null ? form.capacity : '' %>">
        <p class="hint">Для типа «Рэк» — в юнитах (U); для остальных типов — в литрах объёма.</p>
      </div>
      <div class="field">
        <label for="weight">Вес тары (пустого кейса), кг</label>
        <input type="number" id="weight" name="weight" min="0" step="0.1" value="<%= form.weight != null ? form.weight : '' %>">
      </div>
    </div>
    <div class="field">
      <label for="description">Описание</label>
      <textarea id="description" name="description" rows="2"><%= form.description || '' %></textarea>
    </div>
    <% if (!item) { %>
      <div class="field">
        <label for="photo">Фото (опционально)</label>
        <input type="file" id="photo" name="photo" accept="image/*">
      </div>
    <% } %>

    <fieldset>
      <legend>Состав кейса</legend>
      <p class="hint" style="margin-top:-6px; margin-bottom:14px;">Укажите, сколько единиц каждой позиции упаковано в этот кейс (0 — не входит). Ограничение — общее количество позиции в каталоге, а не то, что сейчас свободно.</p>
      <div class="requirement-grid">
        <% equipmentList.forEach(function(eq){ %>
          <div class="requirement-item" style="grid-template-columns: 40px 1fr 80px;">
            <span class="equip-thumb">
              <% if (eq.photoFile) { %><img src="/uploads/equipment/<%= eq.photoFile %>" alt=""><% } else { %>📦<% } %>
            </span>
            <div>
              <div class="rname"><%= eq.name %></div>
              <div class="rdesc">
                Всего в каталоге: <%= eq.quantity %> шт.<% if (eq.location) { %> · <%= eq.location %><% } %>
                <% if (eq.rackUnits != null) { %> · <%= eq.rackUnits %> U<% } %><% if (eq.rackUnits == null && eq.volume != null) { %> · <%= eq.volume %> л<% } %>
              </div>
            </div>
            <input type="number" name="caseitem_<%= eq.id %>" min="0" max="<%= eq.quantity %>" value="<%= selectedMap[eq.id] || 0 %>">
          </div>
        <% }); %>
        <% if (!equipmentList.length) { %>
          <p class="text-faint">Каталог оборудования пуст. Сначала добавьте позиции в разделе «Инвентарь».</p>
        <% } %>
      </div>
    </fieldset>

    <div class="btn-group">
      <button type="submit" class="btn btn-primary"><%= item ? 'Сохранить изменения' : 'Создать кейс' %></button>
      <a href="/equipment/cases" class="btn">Отмена</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') -%>
