<%- include('../partials/head') -%>
<%- include('../partials/header') -%>

<div class="container" style="max-width:640px;">
  <div class="eyebrow">Оборудование</div>
  <h1 style="font-size:28px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text);"><%= title %></h1>

  <% if (item) { %>
    <div class="panel" style="margin-bottom:18px;">
      <div class="panel-title">Фото</div>
      <div style="display:flex; align-items:center; gap:18px; flex-wrap:wrap;">
        <span class="equip-thumb" style="width:72px; height:72px; font-size:28px;">
          <% if (item.photoFile) { %><img src="/uploads/equipment/<%= item.photoFile %>" alt=""><% } else { %>📦<% } %>
        </span>
        <div style="display:flex; flex-direction:column; gap:8px;">
          <form action="/equipment/<%= item.id %>/photo" method="POST" enctype="multipart/form-data" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <input type="file" name="photo" accept="image/*" required>
            <button type="submit" class="btn btn-small">Загрузить</button>
          </form>
          <% if (item.photoFile) { %>
            <form action="/equipment/<%= item.id %>/photo?_method=DELETE" method="POST" data-confirm="Удалить фото?">
              <button type="submit" class="btn btn-small btn-danger">Удалить фото</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <% if (stock && (stock.allocations.length || stock.availableQuantity !== stock.quantity)) { %>
      <div class="panel" style="margin-bottom:18px;">
        <div class="panel-title">Сейчас на складе</div>
        <p>Доступно <%= stock.availableQuantity %> из <%= stock.quantity %>.</p>
        <% if (stock.allocations.length) { %>
          <div style="display:flex; flex-direction:column; gap:4px; margin-top:8px; font-size:13px;">
            <% stock.allocations.forEach(function(a){ %>
              <div><a href="/events/<%= a.event.id %>"><%= a.event.title %></a><% if (a.via) { %> (кейс «<%= a.via %>»)<% } %> — <%= a.quantity %> шт., <%= h.formatDate(a.event.startsAt) %>–<%= h.formatDate(a.event.endsAt) %></div>
            <% }); %>
          </div>
        <% } %>
      </div>
    <% } %>
  <% } %>

  <form action="<%= item ? '/equipment/' + item.id + '?_method=PUT' : '/equipment' %>" method="POST" <%= item ? '' : 'enctype="multipart/form-data"' %> class="stack panel">
    <div class="field">
      <label for="name">Название</label>
      <input type="text" id="name" name="name" value="<%= form.name || '' %>" required>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="quantity">Количество, шт.</label>
        <input type="number" id="quantity" name="quantity" min="1" value="<%= form.quantity || 1 %>">
      </div>
      <div class="field">
        <label for="categoryId">Категория</label>
        <select id="categoryId" name="categoryId">
          <option value="">Без категории</option>
          <% categories.forEach(function(cat){ %>
            <option value="<%= cat.id %>" <%= Number(form.categoryId) === cat.id ? 'selected' : '' %>><%= cat.name %></option>
          <% }); %>
        </select>
        <p class="hint">Каталог категорий расширяется в разделе «Оборудование → Управление категориями».</p>
      </div>
    </div>
    <% if (item) { %>
      <div class="field">
        <label for="status">Статус</label>
        <select id="status" name="status">
          <% statusOrder.forEach(function(key){ %>
            <option value="<%= key %>" <%= form.status === key ? 'selected' : '' %>><%= statusLabels[key] %></option>
          <% }); %>
        </select>
      </div>
    <% } %>
    <div class="field">
      <label for="location">Местоположение</label>
      <input type="text" id="location" name="location" value="<%= form.location || '' %>" placeholder="Напр. Склад А, стеллаж 3">
    </div>
    <div class="field-row">
      <div class="field">
        <label for="volume">Объём (ед.), л</label>
        <input type="number" id="volume" name="volume" min="0" step="0.1" value="<%= form.volume != null ? form.volume : '' %>">
      </div>
      <div class="field">
        <label for="weight">Вес (ед.), кг</label>
        <input type="number" id="weight" name="weight" min="0" step="0.1" value="<%= form.weight != null ? form.weight : '' %>">
      </div>
    </div>
    <div class="field">
      <label for="rackUnits">Высота, U (только для рэкового оборудования)</label>
      <input type="number" id="rackUnits" name="rackUnits" min="0" step="1" value="<%= form.rackUnits != null ? form.rackUnits : '' %>" placeholder="Напр. 2 — для 2U усилителя">
      <p class="hint">Заполняйте, если оборудование монтируется в рэк. Используется для расчёта вместимости рэковых кейсов в юнитах — вместо объёма в литрах.</p>
    </div>
    <div class="field">
      <label for="description">Описание</label>
      <textarea id="description" name="description" rows="3"><%= form.description || '' %></textarea>
    </div>
    <% if (!item) { %>
      <div class="field">
        <label for="photo">Фото (опционально)</label>
        <input type="file" id="photo" name="photo" accept="image/*">
      </div>
    <% } %>
    <div class="btn-group">
      <button type="submit" class="btn btn-primary"><%= item ? 'Сохранить изменения' : 'Добавить оборудование' %></button>
      <a href="/equipment" class="btn">Отмена</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') -%>
