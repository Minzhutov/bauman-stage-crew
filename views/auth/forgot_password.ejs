<%- include('../partials/head') -%>
<%- include('../partials/header') -%>
<div class="auth-wrap">
  <div class="auth-brand"><%- include('../partials/brand_mark', { sizeClass: 'brand-mark-md' }) -%></div>
  <div class="eyebrow">Восстановление доступа</div>
  <h1 style="font-size:28px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text);">Забыли пароль?</h1>
  <div class="auth-card">
    <p class="text-faint" style="margin-top:0;">Укажите email, с которым регистрировались — если он есть на портале, мы отправим на него ссылку для установки нового пароля.</p>
    <form action="/forgot-password" method="POST" class="stack">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= form.email || '' %>" required autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Отправить ссылку</button>
    </form>
  </div>
  <p class="auth-foot"><a href="/login" style="color:var(--violet-bright);">← Вернуться ко входу</a></p>
</div>
<%- include('../partials/footer') -%>
