<%- include('../partials/head') -%>
<%- include('../partials/header') -%>
<div class="auth-wrap">
  <div class="auth-brand"><%- include('../partials/brand_mark', { sizeClass: 'brand-mark-md' }) -%></div>
  <div class="eyebrow">Доступ к консоли</div>
  <h1 style="font-size:28px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text);">Вход в систему</h1>
  <div class="auth-card">
    <form action="/login" method="POST" class="stack">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= form.email || '' %>" required autofocus>
      </div>
      <div class="field">
        <label for="password">Пароль</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Войти</button>
    </form>
  </div>
  <p class="auth-foot">
    <a href="/forgot-password" style="color:var(--text-dim);">Забыли пароль?</a>
    &nbsp;·&nbsp;
    Нет аккаунта? <a href="/register" style="color:var(--violet-bright);">Зарегистрироваться</a>
  </p>
</div>
<%- include('../partials/footer') -%>
