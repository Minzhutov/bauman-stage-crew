<%- include('../partials/head') -%>
<%- include('../partials/header') -%>
<div class="auth-wrap">
  <div class="auth-brand"><%- include('../partials/brand_mark', { sizeClass: 'brand-mark-md' }) -%></div>
  <div class="eyebrow">Набор в команду</div>
  <h1 style="font-size:28px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text);">Регистрация</h1>
  <div class="auth-card">
    <form action="/register" method="POST" class="stack">
      <div class="field-row">
        <div class="field">
          <label for="fullName">Имя и фамилия</label>
          <input type="text" id="fullName" name="fullName" value="<%= form.fullName || '' %>" required autofocus>
        </div>
        <div class="field">
          <label for="studyGroup">Учебная группа</label>
          <input type="text" id="studyGroup" name="studyGroup" value="<%= form.studyGroup || '' %>" placeholder="ИУ7-11" required>
        </div>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= form.email || '' %>" required>
      </div>
      <div class="field">
        <label for="phone">Телефон</label>
        <input type="tel" id="phone" name="phone" value="<%= form.phone || '' %>" placeholder="+7 900 000-00-00">
      </div>
      <div class="field-row">
        <div class="field">
          <label for="password">Пароль</label>
          <input type="password" id="password" name="password" required minlength="6">
        </div>
        <div class="field">
          <label for="passwordConfirm">Повтор пароля</label>
          <input type="password" id="passwordConfirm" name="passwordConfirm" required minlength="6">
        </div>
      </div>
      <p class="hint">Должности и допуски к мероприятиям назначает администратор после регистрации.</p>
      <button type="submit" class="btn btn-primary btn-block">Создать аккаунт</button>
    </form>
  </div>
  <p class="auth-foot">Уже с нами? <a href="/login" style="color:var(--violet-bright);">Войти</a></p>
</div>
<%- include('../partials/footer') -%>
