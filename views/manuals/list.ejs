<%- include('../partials/head') -%>
<%- include('../partials/header') -%>

<div class="container">
  <div class="section-head">
    <div>
      <div class="eyebrow">База знаний</div>
      <h1 style="font-size:32px; text-transform:none; background:none; -webkit-text-fill-color:initial; color:var(--text);">Мануалы</h1>
      <p>Регламенты, инструкции, видео и техническая документация команды.</p>
    </div>
    <% if (auth.isContentStaff(currentUser)) { %>
      <a href="/manuals/new" class="btn btn-primary">+ Новый мануал</a>
    <% } %>
  </div>

  <div class="btn-group" style="margin-bottom:24px; flex-wrap:wrap;">
    <a href="/manuals" class="btn btn-small <%= categoryFilter === '' ? 'btn-primary' : '' %>">Все</a>
    <% categoryOrder.forEach(function(key){ %>
      <% if (categoryCounts[key]) { %>
        <a href="/manuals?category=<%= key %>" class="btn btn-small <%= categoryFilter === key ? 'btn-primary' : '' %>"><%= categoryLabels[key] %> <span class="mono text-faint">· <%= categoryCounts[key] %></span></a>
      <% } %>
    <% }); %>
  </div>

  <% if (!manuals.length) { %>
    <div class="empty"><div class="glyph">📄</div>Мануалов пока нет.</div>
  <% } else { %>
    <div class="card-grid">
      <% manuals.forEach(function(m){ %>
        <a href="/manuals/<%= m.id %>" class="card card-link">
          <div class="card-top">
            <h3><%= m.title %></h3>
            <span class="badge badge-planned"><%= categoryLabels[m.category] || categoryLabels.other %></span>
          </div>
          <% if (m.description) { %><p style="font-size:13px; margin-bottom:10px;"><%= m.description %></p><% } %>
          <div class="meta">
            <% if (m.fileName) { %><span>📎 <%= m.originalName %></span><% } %>
            <% if (m.videoLinks && m.videoLinks.length) { %><span>🎥 <%= m.videoLinks.length %> видео</span><% } %>
            <span>Загрузил: <%= m.uploader ? m.uploader.fullName : '—' %></span>
            <span><%= h.formatDate(m.createdAt) %></span>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') -%>
